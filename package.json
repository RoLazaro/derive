{
  "name": "derive-option-manager",
  "version": "1.0.0",
  "description": "Automated break-even closing for Derive.xyz options",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
